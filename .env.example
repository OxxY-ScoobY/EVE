# PROJECT EVE - Environment Variables Template
# Copy this file to .env.local to configure custom credentials.
# Real credentials should NEVER be committed to version control.

# Google Gemini API Key (Optional: Can also be configured directly in EVE System Settings in-app)
VITE_GEMINI_API_KEY=

# Preferred Model Name (Default: gemini-1.5-flash)
VITE_GEMINI_MODEL=gemini-1.5-flash

# Default Voice Volume (0.0 to 1.0)
VITE_VOICE_VOLUME=1.0

# Port for local development (Default: 5173)
PORT=5173
